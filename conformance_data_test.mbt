    "[table]\n",
    Value::Table(
      Table::from_array([("table", Value::Table(Table::from_array([])))]),
    ),
  ),
  // toml-test valid: table/sub-empty
  (
    "table/sub-empty",
    "[a]\n[a.b]\n",
    Value::Table(
      Table::from_array([
        (
          "a",
          Value::Table(
            Table::from_array([("b", Value::Table(Table::from_array([])))]),
          ),
        ),
      ]),
    ),
  ),
  // toml-test valid: table/whitespace
  (
    "table/whitespace",
    "[\"valid key\"]\n",
    Value::Table(
      Table::from_array([("valid key", Value::Table(Table::from_array([])))]),
    ),
  ),
  // toml-test valid: table/with-literal-string
  (
    "table/with-literal-string",
    "['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n",
    Value::Table(
      Table::from_array([
        (
          "a",
          Value::Table(
            Table::from_array([
              (
                "\"b\"",
                Value::Table(
                  Table::from_array([
                    (
                      "c",
                      Value::Table(
                        Table::from_array([("answer", Value::Int(42L))]),
                      ),
                    ),
                  ]),
                ),
              ),
            ]),
          ),
        ),
      ]),
    ),
  ),
  // toml-test valid: table/with-pound
  (
    "table/with-pound",
    "[\"key#group\"]\nanswer = 42\n",
    Value::Table(
      Table::from_array([
        (
          "key#group",
          Value::Table(Table::from_array([("answer", Value::Int(42L))])),
        ),
      ]),
    ),
  ),
  // toml-test valid: table/with-single-quotes
  (
    "table/with-single-quotes",
    "['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n",
    Value::Table(
      Table::from_array([
        (
          "a",
          Value::Table(
            Table::from_array([
              (
                "b",
                Value::Table(
                  Table::from_array([
                    (
                      "c",
                      Value::Table(
                        Table::from_array([("answer", Value::Int(42L))]),
                      ),
                    ),
                  ]),
                ),
              ),
            ]),
          ),
        ),
      ]),
    ),
  ),
  // toml-test valid: table/without-super
  (
    "table/without-super",
    "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n[x] # defining a super-table afterwards is ok\n",
    Value::Table(
      Table::from_array([
        (
          "x",
          Value::Table(
            Table::from_array([
              (
                "y",
                Value::Table(
                  Table::from_array([
                    (
                      "z",
                      Value::Table(
                        Table::from_array([
                          ("w", Value::Table(Table::from_array([]))),
                        ]),
                      ),
                    ),
                  ]),
                ),
              ),
            ]),
          ),
        ),
      ]),
    ),
  ),
]

