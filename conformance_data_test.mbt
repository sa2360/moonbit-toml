  // toml-test valid: spec-example-1-compact
  (
    "spec-example-1-compact",
    "#Useless spaces eliminated.\ntitle=\"TOML Example\"\n[owner]\nname=\"Lance Uppercut\"\ndob=1979-05-27T07:32:00-08:00#First class dates\n[database]\nserver=\"192.168.1.1\"\nports=[8001,8001,8002]\nconnection_max=5000\nenabled=true\n[servers]\n[servers.alpha]\nip=\"10.0.0.1\"\ndc=\"eqdc10\"\n[servers.beta]\nip=\"10.0.0.2\"\ndc=\"eqdc10\"\n[clients]\ndata=[[\"gamma\",\"delta\"],[1,2]]\nhosts=[\n\"alpha\",\n\"omega\"\n]\n",
    Value::Table(
      Table::from_array([
        (
          "clients",
          Value::Table(
            Table::from_array([
              (
                "data",
                Value::Array([
                  Value::Array([Value::Str("gamma"), Value::Str("delta")]),
                  Value::Array([Value::Int(1L), Value::Int(2L)]),
                ]),
              ),
              (
                "hosts",
                Value::Array([Value::Str("alpha"), Value::Str("omega")]),
              ),
            ]),
          ),
        ),
        (
          "database",
          Value::Table(
            Table::from_array([
              ("connection_max", Value::Int(5000L)),
              ("enabled", Value::Bool(true)),
              (
                "ports",
                Value::Array([
                  Value::Int(8001L),
                  Value::Int(8001L),
                  Value::Int(8002L),
                ]),
              ),
              ("server", Value::Str("192.168.1.1")),
            ]),
          ),
        ),
        (
          "owner",
          Value::Table(
            Table::from_array([
              (
                "dob",
                Value::Datetime({
                  date: Some({ year: 1979, month: 5, day: 27, }),
                  time: Some({ hour: 7, minute: 32, second: 0, nanos: 0, }),
                  offset: -480,
                  has_offset: true,
                }),
              ),
              ("name", Value::Str("Lance Uppercut")),
            ]),
          ),
        ),
        (
          "servers",
          Value::Table(
            Table::from_array([
              (
                "alpha",
                Value::Table(
                  Table::from_array([
                    ("dc", Value::Str("eqdc10")),
                    ("ip", Value::Str("10.0.0.1")),
                  ]),
                ),
              ),
              (
                "beta",
                Value::Table(
                  Table::from_array([
                    ("dc", Value::Str("eqdc10")),
                    ("ip", Value::Str("10.0.0.2")),
                  ]),
                ),
              ),
            ]),
          ),
        ),
        ("title", Value::Str("TOML Example")),
      ]),
    ),
  ),
  // toml-test valid: spec-example-1
  (
    "spec-example-1",
    "# This is a TOML document. Boom.\n\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Lance Uppercut\"\ndob = 1979-05-27T07:32:00-08:00 # First class dates? Why not?\n\n[database]\nserver = \"192.168.1.1\"\nports = [ 8001, 8001, 8002 ]\nconnection_max = 5000\nenabled = true\n\n[servers]\n\n  # You can indent as you please. Tabs or spaces. TOML don't care.\n  [servers.alpha]\n  ip = \"10.0.0.1\"\n  dc = \"eqdc10\"\n\n  [servers.beta]\n  ip = \"10.0.0.2\"\n  dc = \"eqdc10\"\n\n[clients]\ndata = [ [\"gamma\", \"delta\"], [1, 2] ]\n\n# Line breaks are OK when inside arrays\nhosts = [\n  \"alpha\",\n  \"omega\"\n]\n",
    Value::Table(
      Table::from_array([
        (
          "clients",
          Value::Table(
            Table::from_array([
              (
                "data",
                Value::Array([
                  Value::Array([Value::Str("gamma"), Value::Str("delta")]),
                  Value::Array([Value::Int(1L), Value::Int(2L)]),
                ]),
              ),
              (
                "hosts",
                Value::Array([Value::Str("alpha"), Value::Str("omega")]),
              ),
            ]),
          ),
        ),
        (
          "database",
          Value::Table(
            Table::from_array([
              ("connection_max", Value::Int(5000L)),
              ("enabled", Value::Bool(true)),
              (
                "ports",
                Value::Array([
                  Value::Int(8001L),
                  Value::Int(8001L),
                  Value::Int(8002L),
                ]),
              ),
              ("server", Value::Str("192.168.1.1")),
            ]),
          ),
        ),
        (
          "owner",
          Value::Table(
            Table::from_array([
              (
                "dob",
                Value::Datetime({
                  date: Some({ year: 1979, month: 5, day: 27, }),
                  time: Some({ hour: 7, minute: 32, second: 0, nanos: 0, }),
                  offset: -480,
                  has_offset: true,
                }),
              ),
              ("name", Value::Str("Lance Uppercut")),
            ]),
          ),
        ),
        (
          "servers",
          Value::Table(
            Table::from_array([
              (
                "alpha",
                Value::Table(
                  Table::from_array([
                    ("dc", Value::Str("eqdc10")),
                    ("ip", Value::Str("10.0.0.1")),
                  ]),
                ),
              ),
              (
                "beta",
                Value::Table(
                  Table::from_array([
                    ("dc", Value::Str("eqdc10")),
                    ("ip", Value::Str("10.0.0.2")),
                  ]),
                ),
              ),
            ]),
          ),
        ),
        ("title", Value::Str("TOML Example")),
      ]),
    ),
  ),
